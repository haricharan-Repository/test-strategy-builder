{
  "name": "test-strategy-builder",
  "version": "0.1.0",
  "description": "Generate an Excel-based test strategy from a requirement description.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "dev": "vite",
    "server:dev": "node --loader ts-node/esm server.ts",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "preview": "vite preview",
    "start": "npm run build && node dist-server/server.js",
    "start:full": "npm run build && npm run dev:full",
    "cli": "npm run build && node dist-server/src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.0",
    "file-saver": "^2.0.5",
    "mammoth": "^1.4.21",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.18",
    "@types/file-saver": "^2.0.5",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/xlsx": "^0.0.36",
    "@types/yargs": "^17.0.24",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0",
    "vite": "^8.2.1"
  }
}
